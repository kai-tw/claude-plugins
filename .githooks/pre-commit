#!/bin/sh
# Blocks a commit whose staged changes contain a secret. CI runs the same scan,
# so a machine without gitleaks only warns here. Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks isn't installed, so staged changes weren't scanned for secrets (brew install gitleaks)" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
