{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-journal-inject.sh",
            "statusMessage": "Loading session journal..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-journal-cleanup.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-journal-nudge.sh"
          }
        ]
      }
    ]
  }
}
