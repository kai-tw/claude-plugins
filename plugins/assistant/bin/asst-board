#!/usr/bin/env bash
# Launcher — the script lives with the skill that owns it; bin/ is on PATH while the plugin is enabled.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$here/../skills/assistant/scripts/node.sh"
exec_node "$here/../skills/scribe/scripts/board.mjs" "$@"
