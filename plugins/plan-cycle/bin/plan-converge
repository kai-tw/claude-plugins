#!/usr/bin/env bash
# Verification-round accounting for a plan review.
#
# A launcher, not an implementation — the script lives with the agent that owns
# it (see the exec line). It exists so agent files and this plugin's own prose
# can invoke it by BARE NAME: the plugin's bin/ is on the Bash tool's PATH
# whenever the plugin is enabled, while the install path
# (~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/) is not knowable
# from a project-relative reference and changes on every version bump.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec bash "$here/../agents/scripts/plan_converge.sh" "$@"
