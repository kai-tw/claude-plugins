#!/usr/bin/env bash
# Commit-gate leg 2 in test-first mode — the only acceptable red is a stub.
#
# A launcher, not an implementation — the script lives with the skill that owns
# it (see the exec line). It exists so skill files, agent files and this
# plugin's own prose can invoke it by BARE NAME: the plugin's bin/ is on the
# Bash tool's PATH whenever the plugin is enabled, while the install path
# (~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/) is not knowable
# from a project-relative reference and changes on every version bump.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
impl="$here/../skills/engineer/scripts/test_first.sh"

# This runs a suite (its argument IS a test command), but the hook only sees the
# top-level `plan-test-first …`, so it would spend memory off the books. Route
# it through the slot budget for the same reason plan-mutation does.
case "${1:-}" in
  --help|-h|'') exec bash "$impl" "$@" ;;
esac
exec bash "$here/../skills/qa/scripts/plan_test.sh" --exec bash "$impl" "$@"
