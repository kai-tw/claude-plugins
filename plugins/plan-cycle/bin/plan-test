#!/usr/bin/env bash
# Machine-wide concurrency budget for test runs (see the skill script's header).
#
# A launcher, not an implementation — the script lives with the skill that owns
# it (see the exec line). It exists so skill files, agent files, this plugin's
# own prose and the resource-gate hook's deny message can invoke it by BARE
# NAME: the plugin's bin/ is on the Bash tool's PATH whenever the plugin is
# enabled, while the install path
# (~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/) is not knowable
# from a project-relative reference and changes on every version bump.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec bash "$here/../skills/qa/scripts/plan_test.sh" "$@"
