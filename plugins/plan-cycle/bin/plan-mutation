#!/usr/bin/env bash
# Mutation-test the files this cycle changed — the check that tells a real test
# from one that calls every line and asserts nothing.
#
# A launcher, not an implementation — the script lives with the skill that owns
# it (see the exec line). It exists so skill files, agent files and this
# plugin's own prose can invoke it by BARE NAME: the plugin's bin/ is on the
# Bash tool's PATH whenever the plugin is enabled, while the install path
# (~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/) is not knowable
# from a project-relative reference and changes on every version bump.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
impl="$here/../skills/qa/scripts/mutation.sh"

# Mutation is the heaviest thing this machine runs — one test suite per mutant,
# in a loop — and it never types `flutter test` at the top level, so the
# resource-gate hook cannot see it. Route it through the slot budget so it
# cannot spend memory off the books. ONE slot for the whole run, not one per
# mutant: `plan-test --exec` exports PLAN_TEST_SLOT_HELD, so the inner runs pass
# straight through instead of thrashing the semaphore.
case "${1:-}" in
  --help|-h) exec bash "$impl" "$@" ;;   # printing help must not need a slot
esac
exec bash "$here/../skills/qa/scripts/plan_test.sh" --exec bash "$impl" "$@"
