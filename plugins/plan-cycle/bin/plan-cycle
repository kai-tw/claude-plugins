#!/usr/bin/env bash
# plan-cycle.sh — the /plan upload-enforcement ledger.
#
# WHY THIS EXISTS
#   The /plan SKILL.md is loaded ONCE when the cycle starts. Over a long
#   cycle (PM → designer → engineer → code → QA → close-out, dozens of turns,
#   often summarized) its upload obligation (Iron Law 6: "a plan not in Notion
#   does not exist") decays out of the active context, and the model reverts to
#   authoring plans in chat and never invoking archivist. Prose can't fix a
#   context-persistence problem — the deterministic Stop hook can.
#
#   This script is a tiny local ledger that mirrors the archivist's Notion
#   writes. The Stop hook calls `check` every turn and BLOCKS turn-end when the
#   cycle has advanced PAST a plan phase whose Notion row never landed — exactly
#   the way `stop-validate.sh` already makes `dart format` / renderer build
#   un-skippable. Enforcement lives in the hook, not in the model's memory, so
#   it survives summarization.
#
# WHO WRITES IT  (all calls are byproducts of archivist's existing Notion ops,
#                 so the decay-prone launcher needs no new memory-dependent step)
#   - archivist creates the TaskList task   → start  <slug> "<title>"
#   - archivist flips the TaskList Stage     → enter  "<Stage>"
#   - archivist writes a plan DB row (verified) → uploaded <pm|designer|engineer>
#   - launcher opens the PR (Step 6.0)            → pr-opened
#   - /review posts its findings to the PR        → reviewed <sha>
#   - launcher closes out (archive + trash row)   → clear
#     (on a pr_opened cycle whose PR has merged, clear REFUSES until the worktree
#      + branch are gone (Step 6.6) and a feedback-ledger entry carries the cycle
#      slug (Step 6.7) — the two close-out steps that leave no Notion trace, so
#      nothing else would ever notice them missing)
#
# LEDGER SCOPE — per session, shared across trees
#   The ledger is keyed by CLAUDE_CODE_SESSION_ID, so CONCURRENT SESSIONS never
#   see each other's cycle (you can multi-open freely — one session's gap never
#   blocks another). Within one session it lives in the MAIN working tree
#   (resolved via git-common-dir), so that session's planning phases (main tree)
#   and code/close-out phases (worktree) read and write ONE file. It is
#   gitignored — never in a commit or a worktree checkout. The in-thread
#   archivist's Bash calls and this session's Stop hook share the session id, so
#   the writer and the checker always resolve the same file. A session-id
#   mismatch degrades to "no file → no block" (never a false block on unrelated
#   work). Note: resuming a cycle in a BRAND-NEW session won't inherit the old
#   session's ledger (it keys to the new id) — enforcement simply restarts;
#   Notion Stage still reflects reality. The one obligation that must NOT wait
#   for the owning session to return is a merged PR's close-out, so `sweep`
#   reads every ledger in the tree regardless of key (SessionStart hook).
#
# Mutators no-op when no cycle is active; `check` is silent (exit 0) then too —
# so the hook is invisible for non-/plan work. The one exception is `check`'s
# Gate 0 (unpushed worktree commits), which needs no ledger: the rule it enforces
# is about being in a worktree at all, not about being mid-cycle.

set -uo pipefail

# --- locate the single shared ledger (main tree, via git-common-dir) ---------
main_root() {
  local cdir
  cdir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ -n "$cdir" ] || return 1
  dirname "$cdir"   # .../<main-tree>/.git  →  .../<main-tree>
}

# Optional leading `--session <id>` lets the Stop hook pass the id it reads from
# its stdin as an ARGUMENT — so we never set or export an environment variable.
# Writers (archivist) pass nothing and we fall back to reading the harness's
# pre-existing CLAUDE_CODE_SESSION_ID (READ-ONLY; we never mutate the env).
SESSION_OVERRIDE=""
if [ "${1:-}" = "--session" ]; then
  SESSION_OVERRIDE="${2:-}"
  shift 2>/dev/null || true   # drop --session
  shift 2>/dev/null || true   # drop the id
fi

ROOT=$(main_root) || { echo "plan-cycle: not in a git repo" >&2; exit 0; }
LEDGER_DIR="$ROOT/.claude/.plan-cycle"
STALE_DAYS=14   # an abandoned ledger past this age stops gating (hygiene)
# Gate 3 arms above this many unreviewed commits on an open PR's branch. Ten is
# a count a rework stretch reaches only by skipping review, not by working — the
# measured failure ran past forty.
REVIEW_DRIFT_MAX=10
# Gate 0 arms at this many commits sitting on a worktree branch but on no remote.
# TWO, not one: a single fresh commit is the one a sub-agent-recovery amend
# targets (git-ops §3), and pushing it early turns that amend into a force-push,
# which is deny-listed. Two commits is already a phase held back.
UNPUSHED_MAX=2

# Per-session key → concurrent sessions never collide. Sanitize to a safe
# filename; fall back to "active" only for manual CLI runs with no session.
SID="${SESSION_OVERRIDE:-${CLAUDE_CODE_SESSION_ID:-}}"
SID=$(printf '%s' "$SID" | tr -cd 'A-Za-z0-9._-')
[ -n "$SID" ] || SID="active"
LEDGER="$LEDGER_DIR/${SID}.json"

# --- stage / phase ordering --------------------------------------------------
# A plan phase's row must be in Notion once the cycle's Stage has advanced
# strictly PAST that phase's authoring stage. Security/Privacy share the
# Engineering Plan index (they are gates WITHIN the engineer phase), so entering
# them never false-blocks on an engineer draft still in its audit loop.
stage_idx() {
  case "$1" in
    "Product Plan")               echo 0 ;;
    "Design Plan")                echo 1 ;;
    "Translation")                echo 2 ;;
    "Engineering Plan")           echo 3 ;;
    "Security"|"Privacy")         echo 3 ;;
    "Implementation")             echo 4 ;;
    "Review"|"QA")                echo 5 ;;
    "Archived")                   echo 6 ;;
    *)                            echo -1 ;;
  esac
}

# A stage that marks a plan phase "expected" (so phases never entered — e.g.
# designer on a non-UI cycle — are never gated). Inferred from stage entry; the
# launcher need not pre-declare the phase set.
stage_phase() {
  case "$1" in
    "Product Plan")     echo pm ;;
    "Design Plan")      echo designer ;;
    "Engineering Plan") echo engineer ;;
    *)                  echo "" ;;
  esac
}

phase_idx() {  # the authoring-stage index of each plan phase
  case "$1" in
    pm)       echo 0 ;;
    designer) echo 1 ;;
    engineer) echo 3 ;;
    *)        echo -1 ;;
  esac
}

phase_label() {
  case "$1" in
    pm)       echo "Product" ;;
    designer) echo "Design" ;;
    engineer) echo "Engineering" ;;
    *)        echo "$1" ;;
  esac
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Has PR #$1 landed on origin/$2? Close-out runs AFTER the founder merges, so
# this is what arms Gate 2 — the merge, not the PR opening.
#
# Offline by design: the Stop hook runs on every turn-end, so it must not make a
# network call. `gh pr view` is therefore out, and so is
# `git merge-base --is-ancestor` — this repo squash-merges (PRs #111-#115 each
# landed as ONE commit; the last real merge commit on main is #32), so the
# branch tip never becomes an ancestor of the base. What DOES survive a squash
# is GitHub's subject suffix `(#N)`, which is both local and reliable.
#
# Fail-open on a stale `origin/$2` (merged on GitHub, not yet fetched): the gate
# stays silent until the next fetch. That is the safe direction — before the
# merge is observable there is nothing owed, so nothing can be silently skipped.
#
# `grep -c`, never `grep -q`: under this script's `pipefail`, a `-q` grep exits
# on the first match, `git` takes SIGPIPE, and the pipeline reports 141 — but
# only when grep wins the race, so the gate would fire or not at random. `-c`
# drains the stream, so the result is deterministic.
merged_on_base() {
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
  local hits
  hits=$(git -C "$ROOT" log "origin/$2" -n 400 --format='%s' 2>/dev/null \
         | grep -cE "\(#$1\)\$") || true
  [ "${hits:-0}" -gt 0 ]
}

# Gate 4's scanner. `// review-dismiss:` is the marker a DISMISS verdict must
# land at the site (review/SKILL.md §Verdict per finding), and the rule on it is
# already written down and already checkable — nothing was checking it.
#
# Two of the rule's three conditions are pure string comparison and are enforced:
# a reason that is empty or a generic non-reason ("intentional" / "by design" —
# the rule names these), and a rationale that spills onto a second comment line
# (one line is the whole budget: a reason needing a paragraph is a FIX, or a
# principle that belongs in `.claude/rules/`). The third — "precedent alone is
# 推託" — is NOT enforced: telling a bare sibling appeal from a structural
# argument that happens to mention a sibling needs judgment, and a gate that
# guesses at it would fire on correct dismissals. That one stays the reviewer's.
#
# Reads the uncommitted diff only (`-U0`, added lines): the marker is written in
# the same turn as the fix, so this is the moment of the mistake, and untouched
# pre-existing markers are never re-litigated.
review_dismiss_violations() {
  git diff -U0 HEAD -- . 2>/dev/null | awk '
    /^\+\+\+ b\// { file = substr($0, 7); next }
    /^@@/         { pending = 0; next }
    /^\+/ {
      line = substr($0, 2)
      if (pending) {
        # A following comment that is its own directive is not a continuation.
        if (line ~ /^[[:space:]]*\/\/[[:space:]]*(TODO|FIXME|HACK|NOTE|ignore|ignore_for_file|coverage|review-dismiss)/) { pending = 0 }
        else if (line ~ /^[[:space:]]*\/\/\//) { pending = 0 }
        else if (line ~ /^[[:space:]]*\/\//)   { print file "\t" pendreason "\tspills onto a second comment line"; pending = 0; next }
        else pending = 0
      }
      if (line ~ /\/\/[[:space:]]*review-dismiss:/) {
        reason = line
        sub(/.*review-dismiss:[[:space:]]*/, "", reason)
        gsub(/[[:space:]]+$/, "", reason)
        lc = tolower(reason)
        if (reason == "")
          print file "\t(empty)\tno reason at all"
        else if (lc ~ /^(intentional|intended|by design|by-design|as designed|deliberate|on purpose|works as intended)[.。]?$/)
          print file "\t" reason "\ta generic non-reason the rule names explicitly"
        else { pending = 1; pendreason = reason }
      }
      next
    }
    { pending = 0 }
  '
}

# Gate 5's scanner — existing tests edited during the implementation stage.
#
# Under TDD the tests are the specification, and the implementation stage is a
# loop whose objective is a green suite. Green is reachable from BOTH sides, and
# the test side is cheaper: the quickest way past a failing assertion is to
# weaken it. A loop optimises whichever side is editable, so an unfrozen suite
# stops being a specification and becomes a negotiable target — and nothing in
# the artefact records that it moved.
#
# What is actually protected is the tests' PROVENANCE. A test written before the
# implementation existed encodes the requirement; one edited to match what was
# convenient to build encodes the implementation. Those read identically
# afterwards, which is why the mark has to be left at the moment of the edit.
#
# So this is not immutability. A spec that turns out ambiguous, a test with a
# genuine bug, a mechanical rename — all legitimate. They just are not free:
# state the reason at the site, the way a DISMISS verdict does. The next reader
# gets the sentence to attack, exactly as with `// review-dismiss:`.
#
# NEW test files are never blocked — a regression test for something found while
# implementing is the system working. Only edits to files that already existed.
frozen_test_edits() {
  local f hunk out=""
  for f in $(git diff --diff-filter=M --name-only HEAD -- test integration_test 2>/dev/null); do
    hunk=$(git diff -U0 HEAD -- "$f" 2>/dev/null | grep '^+' | grep -c 'test-change:') || true
    case "$hunk" in ''|*[!0-9]*) hunk=0 ;; esac
    [ "$hunk" -gt 0 ] && continue
    out="${out}  • ${f}
"
  done
  printf '%s' "$out"
}

# Branches and worktrees that outlived their merged PR.
#
# `clear`'s teardown gate already checks all three (worktree, local branch,
# remote branch) — but only at close-out, and only while a ledger is alive. The
# ledger is per-session, deleted BY `clear`, and reaped after STALE_DAYS. Once it
# is gone nothing looks at git again, so whichever half survived teardown is
# never mentioned by anyone. Measured on NovelGlide: zero stale worktrees, four
# merged branches still standing (PRs #222, #224, #233, #243) — the worktree is
# the half people remember.
#
# Merge state comes from `gh`, NEVER from a content diff. git-ops §5: read the
# PR's state first and treat the diff as the follow-up. Built the other way round
# it called an OPEN PR's branch landed — the diff scoped to the branch's own
# paths came back empty while the unscoped diff showed 268 files — which is a
# "safe to delete" on live work, the one error this must not make.
#
# Reports ONLY branches whose PR actually merged. A branch with no PR is somebody's
# work in progress, and a cleanup reminder that guesses is one people learn to skip.
#
# `gh` runs only when git found candidates, so the steady state costs no network
# call at all. Every failure path reports nothing: no `gh`, not logged in, offline,
# no remote — a session-start reminder must never become a session-start error.
merged_leftovers() {
  local base cands merged out b wt left
  base=$(git -C "$ROOT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  base=${base#origin/}
  [ -n "$base" ] || base=main

  # origin only — a mirror remote (gitlab) is not the canonical branch list.
  cands=$( { git -C "$ROOT" branch --format='%(refname:short)' 2>/dev/null
             git -C "$ROOT" branch -r --format='%(refname:short)' 2>/dev/null \
               | sed -n 's|^origin/||p'
           } | grep -vx "$base" | grep -vx HEAD | sort -u )
  [ -n "$cands" ] || return 0
  command -v gh >/dev/null 2>&1 || return 0

  merged=$(cd "$ROOT" 2>/dev/null && gh pr list --state merged --limit 300 \
             --json headRefName -q '.[].headRefName' 2>/dev/null) || return 0
  [ -n "$merged" ] || return 0

  out=""
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    printf '%s\n' "$merged" | grep -qxF "$b" || continue
    left=""
    wt=$(git -C "$ROOT" worktree list --porcelain 2>/dev/null \
         | awk -v m="branch refs/heads/$b" '/^worktree /{p=substr($0,10)} $0==m{print p; exit}')
    [ -n "$wt" ] && left="${left}      worktree  ${wt}
        git worktree remove --force ${wt}
"
    git -C "$ROOT" show-ref --verify --quiet "refs/heads/$b" && left="${left}      local     git branch -D ${b}   (-d refuses: a squash-merge never makes the tip an ancestor)
"
    git -C "$ROOT" show-ref --verify --quiet "refs/remotes/origin/$b" && left="${left}      remote    git push origin --delete ${b}
"
    [ -n "$left" ] && out="${out}  • ${b} — PR merged
${left}
"
  done <<EOF
$cands
EOF
  printf '%s' "$out"
}

write_ledger() {  # stdin = jq program; mutates LEDGER atomically
  local tmp; tmp=$(mktemp) || return 1
  if jq "$@" "$LEDGER" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$LEDGER"
  else
    rm -f "$tmp"; return 1
  fi
}

cmd="${1:-}"; [ $# -gt 0 ] && shift

case "$cmd" in
  start)
    slug="${1:-}"; title="${2:-}"
    mkdir -p "$LEDGER_DIR"
    # housekeeping: drop abandoned ledgers from old sessions
    find "$LEDGER_DIR" -maxdepth 1 -name '*.json' -mtime +"$STALE_DAYS" -delete 2>/dev/null || true
    jq -n --arg slug "$slug" --arg title "$title" --arg now "$(now)" '
      { slug: $slug, title: $title, stage: null, stage_idx: -1,
        pr_opened: false,
        phases: {
          pm:       { expected: false, uploaded: false, url: "" },
          designer: { expected: false, uploaded: false, url: "" },
          engineer: { expected: false, uploaded: false, url: "" }
        },
        updated: $now }' > "$LEDGER"
    echo "plan-cycle: started ledger for '${slug:-?}'"
    ;;

  enter)   # archivist advanced the Notion Stage → mirror it
    [ -f "$LEDGER" ] || exit 0
    stage="${1:-}"; idx=$(stage_idx "$stage"); ph=$(stage_phase "$stage")
    write_ledger --arg stage "$stage" --argjson idx "$idx" --arg ph "$ph" --arg now "$(now)" '
      .stage = $stage | .stage_idx = $idx | .updated = $now
      | if $ph != "" then .phases[$ph].expected = true else . end'
    ;;

  uploaded)   # archivist wrote + VERIFIED a plan DB row → mark it landed, with proof
    # Iron Law 6 is "a plan not in Notion does not exist" — so the mark must cost
    # something only a real write can produce. A bare flag cost nothing: the same
    # actor wrote the row and flipped the bit, so a silent write-fail (or a turn
    # that flipped it without writing at all) satisfied Gate 1 with ZERO rows in
    # Notion. Requiring the row's URL closes that: the archivist calls this only
    # after its Iron-Law-2 fetch-back, so it HAS the URL — and if the write
    # failed there is no URL to pass, no flag, and Gate 1 keeps blocking.
    #
    # Enforcement is here, on the write side, not in Gate 1: `uploaded = true`
    # now implies a URL was supplied, so Gate 1 needs no extra check — and the
    # ledgers written before this change (flag set, no URL) keep passing instead
    # of every in-flight cycle blocking at once.
    [ -f "$LEDGER" ] || exit 0
    ph="${1:-}"; url="${2:-}"
    case "$ph" in pm|designer|engineer) ;; *) echo "plan-cycle: unknown phase '$ph'" >&2; exit 0 ;; esac
    # A Notion page URL, or a bare 32-char page id (dashed or not).
    ok=""
    case "$url" in
      https://*|http://*) ok=1 ;;
      *[!0-9a-fA-F-]*|"")  ;;
      *) [ "${#url}" -ge 32 ] && ok=1 ;;
    esac
    if [ -z "$ok" ]; then
      cat >&2 <<EOF
plan-cycle: uploaded REFUSED — no plan-row URL.

  usage: plan-cycle.sh uploaded <pm|designer|engineer> <plan-row-url>

Iron Law 6 — a plan not in Notion does not exist. The mark is what Gate 1
trusts, so it has to carry proof the row is really there: pass the URL (or page
id) the archivist just fetched back to verify it. If you don't have one, the
write did not land — redo it rather than marking it done.
EOF
      exit 1
    fi
    write_ledger --arg ph "$ph" --arg url "$url" --arg now "$(now)" '
      .phases[$ph].expected = true | .phases[$ph].uploaded = true
      | .phases[$ph].url = $url | .updated = $now'
    ;;

  pr-opened)   # launcher opened the PR (Step 6.0) → RECORD it; Gate 2 arms on merge
    [ -f "$LEDGER" ] || exit 0
    pr="${1:-}"; base="${2:-main}"
    case "$pr" in
      ''|*[!0-9]*)
        # Degrade in the fail-open direction: `clear` still owes a retro, but
        # Gate 2 has no PR to watch, so a dropped close-out won't be caught.
        echo "plan-cycle: pr-opened without a PR number — close-out gate disabled for this cycle (use: pr-opened <PR#> [base])" >&2
        write_ledger --arg now "$(now)" '.pr_opened = true | .updated = $now'
        exit 0
        ;;
    esac
    # Capture the branch so `clear` can verify the Step 6.6 teardown against git
    # rather than trust a flag. Step 6.0 runs from INSIDE the worktree, so the
    # CALLER's cwd names it — read it without `-C "$ROOT"`, which would name the
    # main tree's branch instead; a 3rd argument overrides for calls made from
    # elsewhere. A base branch or a detached HEAD records nothing: a base is
    # never torn down, so recording one would leave a ledger that no teardown can
    # satisfy, and an unclearable ledger is worse than an unwatched branch.
    branch="${3:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null)}"
    case "$branch" in "$base"|HEAD|"") branch="" ;; esac
    # Gate 3's baseline. Phase 12's /review graded the tree that became this tip,
    # so HEAD here is the last commit a reviewer actually saw. A drift count with
    # no origin can never arm, so record one at the only moment it is free.
    head=$(git rev-parse HEAD 2>/dev/null) || head=""
    write_ledger --arg pr "$pr" --arg base "$base" --arg br "$branch" \
                 --arg head "$head" --arg now "$(now)" '
      .pr_opened = true | .pr = $pr | .base = $base | .updated = $now
      | if $br != "" then .branch = $br else . end
      | if $head != "" and (.reviewed_sha // "") == "" then .reviewed_sha = $head else . end'
    ;;

  reviewed)   # /review posted its findings → re-baseline the drift gate
    # Gate 3 needs an origin, and the only honest one is the commit a reviewer
    # actually read. /review is the sole writer: it already holds that sha (the
    # same one it puts in the PR comment) and it runs once per pass, so the mark
    # adds no step anyone has to remember. A sha git cannot resolve is REFUSED
    # rather than stored — a baseline that resolves to nothing disarms the gate
    # permanently and silently, which is the failure this gate exists to catch.
    [ -f "$LEDGER" ] || exit 0
    sha="${1:-}"
    full=$(git -C "$ROOT" rev-parse --verify --quiet "${sha}^{commit}" 2>/dev/null) || full=""
    if [ -z "$full" ]; then
      echo "plan-cycle: reviewed REFUSED — '${sha:-}' is not a commit here (usage: plan-cycle reviewed <sha>)" >&2
      exit 1
    fi
    write_ledger --arg sha "$full" --arg now "$(now)" '
      .reviewed_sha = $sha | .reviewed_at = $now | .updated = $now'
    ;;

  clear)   # close-out (Feature Archive verified + task row trashed) or a reset
    # Two gates guard `clear`, both armed only on a FULL cycle (pr_opened) and
    # both verified against the ARTIFACT rather than a flag: the teardown
    # (Step 6.6) and the runner-feedback row (Step 6.7). Resets of never-shipped
    # ledgers (pr_opened=false: Gate-1 escapes, non-cycles) stay unconditional.
    if [ -f "$LEDGER" ]; then
      pr_opened=$(jq -r '.pr_opened // false' "$LEDGER" 2>/dev/null)
      slug=$(jq -r '.slug // ""' "$LEDGER" 2>/dev/null)

      # --- Teardown gate (Step 6.6) -------------------------------------------
      # `clear` deletes the ledger, so it is the LAST moment anything asks: a
      # worktree and branch still standing when it succeeds are never mentioned
      # again by anyone. The arming edge is the MERGE, same as Gate 2 — before it
      # keeping the worktree is correct (Step 6.6 never auto-removes an unmerged
      # one). Fail open on an unrecorded branch (ledgers opened before 0.5.0,
      # plan-only cycles, a `pr-opened` that took no PR number).
      pr=$(jq -r '.pr // ""' "$LEDGER" 2>/dev/null)
      base=$(jq -r '.base // "main"' "$LEDGER" 2>/dev/null)
      branch=$(jq -r '.branch // ""' "$LEDGER" 2>/dev/null)
      if [ "$pr_opened" = "true" ] && [ -n "$branch" ] && merged_on_base "$pr" "$base"; then
        left=""
        wt=$(git -C "$ROOT" worktree list --porcelain 2>/dev/null \
             | awk -v b="branch refs/heads/$branch" '/^worktree /{p=substr($0,10)} $0==b{print p; exit}')
        [ -n "$wt" ] && left="$left
  • worktree at ${wt}
      ExitWorktree action:\"remove\" discard_changes:true — a SILENT no-op on a
      worktree from an earlier session, so verify; then git worktree remove --force"
        git -C "$ROOT" show-ref --verify --quiet "refs/heads/$branch" && left="$left
  • local branch ${branch}
      git branch -D ${branch}  (-d refuses: a squash-merge never makes the tip
      an ancestor)"
        git -C "$ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch" && left="$left
  • remote branch origin/${branch}
      git push origin --delete ${branch}  (already gone on GitHub? git fetch --prune)"
        if [ -n "$left" ]; then
          cat >&2 <<EOF
plan-cycle: CLEAR REFUSED — PR #${pr} merged, but its worktree/branch are still here.

  Cycle:  ${slug}
  Branch: ${branch}

Step 6.6 (plan/SKILL.md §Step 6) tears these down, and clearing is the last
moment anything asks — the ledger goes away with it. Still standing:
${left}

Then re-run: plan-cycle clear
EOF
          exit 1
        fi
      fi

      # --- Feedback gate (Step 6.7) -------------------------------------------
      # Ask the ledger where it keeps entries rather than hardcoding it here.
      # This path used to be written out in two places that had to agree; the
      # copy in this file is the one that would have gone stale silently,
      # because a wrong path here reads as "no entry filed" and blocks
      # close-out forever instead of erroring. Fail open if the lookup fails
      # for any reason — a gate that cannot find the ledger must not become an
      # unclearable ledger.
      FEEDBACK=$("$(dirname "${BASH_SOURCE[0]}")/plan-feedback" dir 2>/dev/null) || FEEDBACK=""
      if [ -n "$FEEDBACK" ] && [ "$pr_opened" = "true" ] && [ -n "$slug" ] && [ "$slug" != "?" ] \
         && ! grep -rFq "$slug" "$FEEDBACK" 2>/dev/null; then
        cat >&2 <<EOF
plan-cycle: CLEAR REFUSED — no runner-feedback entry for this cycle.

  Cycle: ${slug}

Step 6.7 (plan/SKILL.md §Process retro): before clearing, file ONE process
entry carrying this cycle's slug (in the MAIN tree) — fields per §Process
retro (per-gate R/H/L · the measurement row · friction · the MANDATORY
subtraction candidate):

  plan-feedback add process \\
    --source runner --cycle ${slug} --title "Cycle retro: ${slug}" <<'BODY'
  …
  BODY

Then re-run: plan-cycle clear
(If this ledger is a misfire, the entry still applies — one line noting the
misfire is itself retro data.)
EOF
        exit 1
      fi
    fi
    rm -f "$LEDGER"
    # --- Consume nudge (feedback-ledger) --------------------------------------
    # Close-out is the one natural moment to remind: once per cycle, never per
    # turn, and shipped WITH the plugin — the ledger's old note pointed at a
    # project-side Stop hook this plugin never shipped, so in a repo without
    # one the only consume trigger was the founder remembering. Fail open on
    # every path: a missing launcher must never make `clear` noisy or fail.
    # `bash "$FB"`, `-f` not `-x`: an exec bit can be lost in transit (a copy,
    # an unzip) and a nudge that silently vanished with it would be this
    # mechanism's own silent-skip.
    FB="$(dirname "${BASH_SOURCE[0]}")/plan-feedback"
    if [ -f "$FB" ]; then
      over=$(bash "$FB" over 5 2>/dev/null) || true
      [ -n "$over" ] && printf 'plan-cycle: NOTE — feedback ledger over threshold; run a consume batch (feedback-ledger §Consume routing):\n%s\n' "$over" | sed '2,$s/^/  /'
      rb=$(bash "$FB" count recurring-bug 2>/dev/null | awk 'NR==1 { print $2 }') || true
      case "$rb" in ''|*[!0-9]*) rb=0 ;; esac
      [ "$rb" -gt 0 ] && printf 'plan-cycle: NOTE — %s open recurring-bug entr%s — a recurrence lesson has no safe backlog depth; consume into the qa failure-class index or the consistency mechanism table.\n' "$rb" "$([ "$rb" -eq 1 ] && echo y || echo ies)"
    fi
    :   # a quiet ledger must not turn clear's exit code into 1 — the NOTE
        # lines are informational, and clear succeeded the moment rm ran
    ;;

  status)  # human / debug
    [ -f "$LEDGER" ] || { echo "plan-cycle: no active cycle"; exit 0; }
    cat "$LEDGER"
    ;;

  check)   # the Stop hook calls this. exit 1 + reason on a gap; exit 0 otherwise.
    # Gate 0 — commits sitting on a worktree branch that no remote has.
    #
    # The one gate that needs NO ledger: the rule it enforces (git-ops/SKILL.md §1
    # — "a worktree branch is pushed FREELY, per-phase") binds on any worktree
    # turn. It was already written down, already pre-authorized, and still held
    # only while the founder was watching — four reminders in one round, ending
    # 「push... worktree 內可以不要我提醒了嗎？」. A written permission is not a
    # trigger; this is the trigger.
    #
    # Linked worktrees ONLY (git-dir ≠ git-common-dir), and never on a base
    # branch: `git push origin main` while an open PR is the review surface shifts
    # that PR's merge-base (git-ops §1), so telling anyone to push main would
    # invert the rule this gate serves.
    gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || gd=""
    gcd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || gcd=""
    if [ -n "$gd" ] && [ -n "$gcd" ] && [ "$gd" != "$gcd" ]; then
      wb=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || wb=""
      case "$wb" in main|master|HEAD|"") wb="" ;; esac
      # A repo with no remote has nothing to push to, and `--not --remotes` would
      # then count every commit in history — a gate that can never be satisfied.
      [ -n "$(git remote 2>/dev/null)" ] || wb=""
      if [ -n "$wb" ]; then
        # `--not --remotes` = reachable from HEAD, from no remote-tracking ref —
        # true whether or not the branch has an upstream, so a never-pushed branch
        # counts the same as one that fell behind.
        unpushed=$(git rev-list --count HEAD --not --remotes 2>/dev/null) || unpushed=""
        case "$unpushed" in ''|*[!0-9]*) unpushed=0 ;; esac
        if [ "$unpushed" -ge "$UNPUSHED_MAX" ]; then
          cat <<EOF
PLAN-CYCLE PUSH GATE — ${unpushed} commits on ${wb} are on no remote.

  Worktree: $(pwd)

git-ops §1 — a worktree branch is pushed FREELY, per-phase. Pushing is already
pre-authorized; holding commits back until close-out is the thing the rule
forbids, and origin being current is what makes the branch reviewable as it
grows. Push now, in this turn:

  git push -u origin ${wb}

origin, never the gitlab mirror (git-ops §1). If the top commit is mid-recovery
and about to be amended, amend it FIRST, then push — never push and force-push.
EOF
          exit 1
        fi
      fi
    fi

    # Gate 4 — a `// review-dismiss:` marker that does not meet its own rule.
    # Ledger-independent, like Gate 0: a DISMISS verdict is written whenever a
    # review runs, cycle or no cycle.
    rd=$(review_dismiss_violations)
    if [ -n "$rd" ]; then
      cat <<EOF
PLAN-CYCLE REVIEW-DISMISS GATE — a dismissal in the working tree does not meet its own rule.

$(printf '%s\n' "$rd" | awk -F'\t' '{ printf "  • %s\n      reason: %s\n      problem: %s\n", $1, $2, $3 }')

review/SKILL.md §Verdict per finding: a DISMISS lands a **one-line**
\`// review-dismiss: <reason>\` at the site, and the reason must say why the code
is correct — specific, not generic, and one line is the whole budget. A rationale
that needs a paragraph is not a dismissal: it is a FIX, or a principle that
belongs in \`.claude/rules/\`.

Fix each one, or re-classify the finding as FIX. Remember the condition this gate
does NOT check: precedent alone ("the sibling does it") is 推託, not a reason —
if that is your only defence, the verdict is FIX.
EOF
      exit 1
    fi

    [ -f "$LEDGER" ] || exit 0
    if find "$LEDGER" -mtime +"$STALE_DAYS" 2>/dev/null | grep -q .; then exit 0; fi
    cur=$(jq -r '.stage_idx // -1' "$LEDGER" 2>/dev/null) || exit 0
    [ -n "$cur" ] || exit 0
    slug=$(jq -r '.slug // "?"' "$LEDGER" 2>/dev/null)
    title=$(jq -r '.title // ""' "$LEDGER" 2>/dev/null)
    stage=$(jq -r '.stage // "—"' "$LEDGER" 2>/dev/null)
    pending=""
    for ph in pm designer engineer; do
      exp=$(jq -r --arg p "$ph" '.phases[$p].expected' "$LEDGER" 2>/dev/null)
      up=$(jq -r --arg p "$ph" '.phases[$p].uploaded' "$LEDGER" 2>/dev/null)
      pidx=$(phase_idx "$ph")
      if [ "$exp" = "true" ] && [ "$up" = "false" ] && [ "$cur" -gt "$pidx" ] 2>/dev/null; then
        pending="$pending $ph"
      fi
    done
    pending=$(echo "$pending" | xargs 2>/dev/null || true)

    # Gate 1 (Iron Law 6) — a plan phase advanced past but never uploaded.
    if [ -n "$pending" ]; then
      names=""; actions=""
      for ph in $pending; do
        lbl=$(phase_label "$ph")
        names="$names, the ${lbl} plan"
        actions="$actions
  • ${lbl} plan → invoke \`archivist\` to write its Notion DB row (linked to the
    task) and fetch it back to confirm; archivist then runs
    \`plan-cycle uploaded ${ph} <plan-row-url>\`"
      done
      names=${names#, }

      cat <<EOF
PLAN-CYCLE UPLOAD GATE — a plan you advanced past is NOT in Notion.

  Cycle:  ${slug}${title:+ (${title})}
  Stage:  ${stage}
  Missing: ${names}.

Iron Law 6 — a plan not in Notion does not exist. The cycle has moved past these
phase(s) but their plan rows were never uploaded. Do this NOW, before any other
work:
${actions}

If a listed phase was intentionally not part of this cycle, reset the ledger:
  plan-cycle clear
EOF
      exit 1
    fi

    # Gate 2 (Iron Law 7) — the PR MERGED but the cycle was never closed out
    # (Feature Archive + task-row trash + clear). The ledger surviving past the
    # merge IS the dropped-close-out signal — a clean close-out clears it.
    #
    # The arming edge is the MERGE, not the PR opening: close-out archives only
    # what actually shipped, and until then the Notion plan rows + the PR
    # comments hold the record. Arming at PR-open blocked turn-end for the whole
    # founder-review window while demanding work that could not yet be done —
    # whose only escapes were a false close-out or a `clear` that disarmed the
    # gate before the moment it exists to catch. Filed three times (#92, #109,
    # #111) before the edge was moved.
    #
    # Fail-open twice, both safe: no PR number recorded, or the merge not yet
    # visible on the local `origin/$base`. Neither can hide an owed close-out —
    # before the merge, none is owed.
    pr=$(jq -r '.pr // ""' "$LEDGER" 2>/dev/null)
    base=$(jq -r '.base // "main"' "$LEDGER" 2>/dev/null)
    if [ -n "$pr" ] && merged_on_base "$pr" "$base"; then
      cat <<EOF
PLAN-CYCLE CLOSE-OUT GATE — PR #${pr} merged but the cycle was never closed out.

  Cycle:  ${slug}${title:+ (${title})}
  Stage:  ${stage}

Iron Law 7 — a cycle is not done until it is closed out, and a dropped close-out
is the single most common silent skip. The PR shipped; the close-out is not done.
Do this NOW, before any other work:
  • create + verify the Feature Archive row (\`archivist\`)
  • trash the task row (\`ntn pages trash <id> --yes\`) and confirm it is gone
  • tear down the worktree + its local AND remote branch (Step 6.6) — \`clear\`
    verifies this against git and refuses while any of the three survives
  • file the runner-feedback entry (Step 6.7) via
    \`plan-feedback\` — --cycle '${slug}'
  • then clear the ledger: \`plan-cycle clear\`

If this was intentionally not a /plan cycle, reset the ledger:
  plan-cycle clear
EOF
      exit 1
    fi

    # Gate 3 (Iron Law 7's other half) — the PR is open and commits have piled up
    # since the last /review.
    #
    # The measured failure (PR #204): after the final review round the branch grew
    # 40+ commits — a whole transfer layer deleted, a service base class swapped, a
    # cubit generalized, soft/hard delete moved across features — with ZERO
    # reviewer spawns, and the founder then read all 24 defects by hand. `/qa` ran
    # eleven times over the same stretch, because a refactor turns tests red on its
    # own. Review has no equivalent red light, so it silently did not happen: the
    # gate was bound to "a round of engineering finished", never to "the PR grew
    # this much unreviewed". This is the missing red light.
    #
    # Armed only AFTER the PR opens (earlier work is gated at Phase 12's commit)
    # and only while it is unmerged (Gate 2 owns the merged case and exits above).
    # Fails open on no branch, no baseline, or an unresolvable ref.
    pr_opened=$(jq -r '.pr_opened // false' "$LEDGER" 2>/dev/null)
    branch=$(jq -r '.branch // ""' "$LEDGER" 2>/dev/null)
    rsha=$(jq -r '.reviewed_sha // ""' "$LEDGER" 2>/dev/null)
    if [ "$pr_opened" = "true" ] && [ -n "$branch" ] && [ -n "$rsha" ]; then
      # Resolve the branch by REF from the main tree, never HEAD: the Stop hook
      # fires wherever the turn ended, and a turn that ended in the main tree
      # would otherwise count main's commits instead of the cycle's.
      drift=$(git -C "$ROOT" rev-list --count "$rsha..refs/heads/$branch" 2>/dev/null) || drift=""
      case "$drift" in ''|*[!0-9]*) drift=0 ;; esac
      if [ "$drift" -gt "$REVIEW_DRIFT_MAX" ]; then
        rat=$(jq -r '.reviewed_at // "PR open"' "$LEDGER" 2>/dev/null)
        short=$(git -C "$ROOT" rev-parse --short "$rsha" 2>/dev/null)
        cat <<EOF
PLAN-CYCLE REVIEW-DRIFT GATE — ${drift} unreviewed commits on ${branch}.

  Cycle:  ${slug}${title:+ (${title})}
  PR:     #${pr}
  Since:  ${short} (${rat})

Rework rewrites structure an earlier review already approved, and it is usually
absent from the plan's §Classes — so it is the stretch that most needs a review
pass and the one that most often skips it. Do this NOW, before other work:

  • \`/review\` the diff \`${short}..refs/heads/${branch}\` — code-reviewer, plus
    consistency-reviewer if a layer moved, merged, or was deleted
  • post the findings to PR #${pr} **carrying the reviewed sha**
    (review/SKILL.md §Posting findings to the PR)
  • re-baseline: \`plan-cycle reviewed <the sha you reviewed>\`

If these commits genuinely carry no review surface (a revert, a rebase, a
mechanical rename), say so in the PR thread and re-baseline the same way.
EOF
        exit 1
      fi
    fi

    # Gate 5 — an existing test edited while implementing, with no reason at the
    # site. Armed by the ledger's stage, because "the implementation loop is
    # running" is a cycle fact with no signal in git: the same edit is correct
    # during test authoring and suspect during implementation.
    if [ "$stage" = "Implementation" ]; then
      froz=$(frozen_test_edits)
      if [ -n "$froz" ]; then
        cat <<EOF
PLAN-CYCLE TEST-FREEZE GATE — tests edited during implementation, with no reason at the site.

${froz}

The tests are the specification, and this stage is a loop aiming at a green
suite. Green is reachable from both sides and the test side is cheaper, so an
unfrozen suite stops being a specification and becomes a negotiable target.

Editing one is allowed; doing it silently is not. Add, in the same diff, at the
site of the change:

  // test-change: <why the TEST was wrong, not why the code is hard>

If the honest reason is "the code does not do this", that is not a test change —
it is the finding, and the code is what moves. If the reason is "the spec was
ambiguous", that is a Phase 11 divergence: fix it upstream and let the test
follow. Adding a NEW test file is never blocked.
EOF
        exit 1
      fi
    fi

    exit 0
    ;;

  # A close-out is owed the moment the PR merges, but the ledger that records it
  # is keyed to the session that opened the PR — and the merge usually lands
  # several sessions later. `check` (Gate 2) therefore cannot see it: it reads
  # only the CURRENT session's ledger, so the owed close-out surfaces only if an
  # unrelated later turn in that same session happens to trip the Stop hook.
  # `sweep` closes that window by reading EVERY ledger in the tree and reporting
  # the merged-but-open ones. It is informational and never blocks — SessionStart
  # has no block channel, and a cross-session report is a reminder, not a verdict
  # about the turn that is starting.
  sweep)
    owed=""
    for f in "$LEDGER_DIR"/*.json; do
      [ -e "$f" ] || continue
      pr=$(jq -r '.pr // ""' "$f" 2>/dev/null)
      [ -n "$pr" ] || continue
      base=$(jq -r '.base // "main"' "$f" 2>/dev/null)
      merged_on_base "$pr" "$base" || continue
      slug=$(jq -r '.slug // ""' "$f" 2>/dev/null)
      title=$(jq -r '.title // ""' "$f" 2>/dev/null)
      stage=$(jq -r '.stage // "?"' "$f" 2>/dev/null)
      whose=""
      [ "$(basename "$f" .json)" = "$SID" ] || whose="  ← opened in an earlier session"
      owed="${owed}  • PR #${pr} merged — ${slug}${title:+ (${title})} · Stage ${stage}${whose}
"
    done
    if [ -n "$owed" ]; then
      cat <<EOF
PLAN-CYCLE — merged PR with an unclosed cycle ledger:

${owed}
Iron Law 7 — a cycle is not done until it is closed out. Reconcile before taking
new work: verify against Notion whether the close-out actually ran, then either
finish it (Feature Archive row, trash the task row, tear down the worktree +
branch, \`plan-feedback\` entry) or, if it did run and only the ledger survived,
\`plan-cycle clear\`.
EOF
    fi

    # The ledger-independent half. Everything above needs a ledger to notice
    # anything, and the leftovers that actually accumulate are the ones whose
    # ledger is long gone.
    stale=$(merged_leftovers)
    if [ -n "$stale" ]; then
      cat <<EOF

PLAN-CYCLE — branches whose PR merged, still standing:

${stale}

Step 6.6 tears these down at close-out, and nothing asks again afterwards — the
ledger that would have is deleted by \`clear\` itself. Delete them now, or say
why one is being kept. Only merged PRs are listed; a branch with no PR is left
alone.
EOF
    fi
    exit 0
    ;;

  *)
    echo "usage: plan-cycle.sh {start <slug> <title>|enter <Stage>|uploaded <pm|designer|engineer> <plan-row-url>|pr-opened <PR#> [base] [branch]|reviewed <sha>|clear|status|check|sweep}" >&2
    exit 0
    ;;
esac
