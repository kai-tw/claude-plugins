#!/usr/bin/env bash
# Developer-disk space reclamation.
#
# A launcher, not an implementation — the script lives with the skill that owns
# it (see the exec line). It exists so skill files, agent files and this
# plugin's own prose can invoke it by BARE NAME: the plugin's libexec/ is on the
# Bash tool's PATH (hooks/path.sh puts it there), while the install path
# (~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/) is not knowable
# from a project-relative reference and changes on every version bump.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec bash "$here/../skills/reclaim-space/scripts/reclaim_space.sh" "$@"
