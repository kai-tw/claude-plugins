#!/usr/bin/env bash
# Post plan-mutation's review-mode survivors on a PR. A launcher: the script
# lives with the skill that owns it, and bin/ is on PATH while the plugin is
# enabled.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec bash "$here/../skills/test-gates/scripts/review.sh" "$@"
