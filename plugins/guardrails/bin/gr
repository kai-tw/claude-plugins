#!/usr/bin/env bash
# gr — the guardrails ledger.
#
# TWO OPPOSITE DISCIPLINES, ON PURPOSE
#   entries/  append blindly. An inbox with a high bar is an inbox nobody fills,
#             and the founder correction that never got filed is the one signal
#             that actually improves anything.
#   rules/    every addition must FUSE. A lesson that is a special case of an
#             existing rule rewrites that rule; it does not grow a sibling.
#             Rules are what speak out loud, and a bloated rule set is wallpaper
#             — which is worse than no rule set, because it trains dismissal.
#   `consume` is the filter between them, and it refuses a bare append.

set -uo pipefail

# Data lives in the plugin's SOURCE repo, not the versioned cache copy: an
# install creates a NEW version directory, so anything written into the cache is
# stranded at the old version on the next bump.
src_root() {
  local mk=~/.claude/plugins/known_marketplaces.json loc=''
  [ -r "$mk" ] && loc=$(node -e '
    try{const j=require(process.argv[1]);
        for(const m of Object.values(j)) if(m.installLocation &&
          require("fs").existsSync(m.installLocation+"/plugins/guardrails"))
          {console.log(m.installLocation+"/plugins/guardrails");break}}catch(e){}' "$mk" 2>/dev/null)
  [ -n "$loc" ] && { printf '%s' "$loc"; return; }
  cd "$(dirname "$0")/.." && pwd            # running from the source repo
}
ROOT=$(src_root)
ENTRIES="$ROOT/entries"
RULES_DIR="$ROOT/rules"
CATS='tool claim scope'

die() { printf 'gr: %s\n' "$*" >&2; exit 1; }
valid_cat() { case " $CATS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
rules_file() { printf '%s/%s.tsv' "$RULES_DIR" "$1"; }

usage() {
  cat <<'USAGE'
gr add <cat> --source <founder|agent> --title "<one line>"   # body on stdin
gr list [cat]
gr count
gr rules [cat]
gr consume <entry-path> --extends <id> --message "<merged>"
gr consume <entry-path> --new --id <id> --pattern <ERE> --message "<msg>" \
           --fires-on "<cmd that must match>" --quiet-on "<cmd that must not>"
gr consume <entry-path> --drop "<why this changes nothing>"

Categories: tool (fires at PreToolUse) · claim · scope (injected at SessionStart)
USAGE
}

cmd=${1:-}; shift 2>/dev/null || true
case "$cmd" in

add)
  cat=${1:-}; shift 2>/dev/null || true
  valid_cat "$cat" || die "unknown category '$cat' (one of: $CATS)"
  source=''; title=''
  while [ $# -gt 0 ]; do
    case $1 in
      --source) source=${2:-}; shift 2 ;;
      --title)  title=${2:-};  shift 2 ;;
      *) die "unexpected arg '$1'" ;;
    esac
  done
  [ -n "$source" ] || die '--source is required (founder|agent)'
  [ -n "$title" ]  || die '--title is required'
  case $source in founder|agent) ;; *) die "--source must be founder or agent" ;; esac
  body=$(cat); [ -n "$body" ] || die 'body on stdin is required — what happened, and why it matters'
  slug=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' \
         | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//' | cut -c1-60)
  date=$(date +%F)
  mkdir -p "$ENTRIES/$cat"
  f="$ENTRIES/$cat/$date-$slug.md"
  [ -e "$f" ] && die "entry already exists: $f"
  { printf -- '---\ncategory: %s\nsource: %s\ndate: %s\ntitle: %s\n---\n\n' \
      "$cat" "$source" "$date" "$title"; printf '%s\n' "$body"; } > "$f"
  printf 'filed  %s\n' "${f#"$ROOT/"}"
  ;;

list)
  cat=${1:-}
  for c in $CATS; do
    [ -n "$cat" ] && [ "$c" != "$cat" ] && continue
    for f in "$ENTRIES/$c"/*.md; do
      [ -e "$f" ] || continue
      s=$(sed -n 's/^source: //p' "$f" | head -1)
      t=$(sed -n 's/^title: //p'  "$f" | head -1)
      printf '  %-7s %-8s %-52s %s\n' "$c" "$s" "$t" "${f#"$ENTRIES/"}"
    done
  done
  ;;

count)
  tot=0
  for c in $CATS; do
    n=$(ls "$ENTRIES/$c"/*.md 2>/dev/null | grep -c . || true)
    printf '  %-7s %s\n' "$c" "$n"; tot=$((tot+n))
  done
  printf '  %-7s %s\n' TOTAL "$tot"
  ;;

rules)
  cat=${1:-}
  for c in $CATS; do
    [ -n "$cat" ] && [ "$c" != "$cat" ] && continue
    f=$(rules_file "$c"); [ -r "$f" ] || continue
    printf '── %s ──\n' "$c"
    while IFS=$'\t' read -r id pat msg _; do
      case "$id" in \#*|'') continue ;; esac
      printf '  %-12s %s\n' "$id" "$msg"
    done < "$f"
  done
  ;;

consume)
  entry=${1:-}; shift 2>/dev/null || true
  [ -f "$entry" ] || die "entry not found: $entry"
  cat=$(sed -n 's/^category: //p' "$entry" | head -1)
  valid_cat "$cat" || die "entry has no valid category"
  rf=$(rules_file "$cat")
  mode=''; id=''; pat=''; msg=''; fires=''; quiet=''; why=''
  while [ $# -gt 0 ]; do
    case $1 in
      --extends)  mode=extends; id=${2:-}; shift 2 ;;
      --new)      mode=new; shift ;;
      --drop)     mode=drop; why=${2:-}; shift 2 ;;
      --id)       id=${2:-};    shift 2 ;;
      --pattern)  pat=${2:-};   shift 2 ;;
      --message)  msg=${2:-};   shift 2 ;;
      --fires-on) fires=${2:-}; shift 2 ;;
      --quiet-on) quiet=${2:-}; shift 2 ;;
      *) die "unexpected arg '$1'" ;;
    esac
  done

  if [ -z "$mode" ]; then
    printf 'Existing %s rules — does this entry extend one of them?\n\n' "$cat"
    "$0" rules "$cat"
    printf '\nDeclare one:  --extends <id> --message "<merged>"  |  --new ...  |  --drop "<why>"\n'
    die 'a bare append is not an option; fusion is the whole point'
  fi

  case $mode in
    extends)
      [ -n "$id" ] && [ -n "$msg" ] || die '--extends needs --message "<the merged wording>"'
      grep -qE "^$id"$'\t' "$rf" || die "no rule '$id' in $cat"
      awk -F'\t' -v OFS='\t' -v i="$id" -v m="$msg" '$1==i{$3=m}1' "$rf" > "$rf.tmp" && mv "$rf.tmp" "$rf"
      printf 'fused into %s/%s\n' "$cat" "$id"
      ;;
    new)
      [ -n "$id" ] && [ -n "$pat" ] && [ -n "$msg" ] || die '--new needs --id, --pattern, --message'
      grep -qE "^$id"$'\t' "$rf" 2>/dev/null && die "rule '$id' already exists — did you mean --extends?"
      if [ "$cat" = tool ]; then
        [ -n "$fires" ] && [ -n "$quiet" ] || die \
          '--new in `tool` needs --fires-on and --quiet-on: a pattern is not admissible until it is shown to match the bad command AND leave a healthy one alone'
        printf '%s' "$fires" | grep -qE "$pat" || die "--fires-on does not match the pattern"
        printf '%s' "$quiet" | grep -qE "$pat" && die "--quiet-on DOES match — this pattern would fire on healthy commands"
      fi
      inc=$(sed -n 's/^title: //p' "$entry" | head -1)
      printf '%s\t%s\t%s\t%s\n' "$id" "$pat" "$msg" "$inc" >> "$rf"
      printf 'added %s/%s\n' "$cat" "$id"
      ;;
    drop)
      [ -n "$why" ] || die '--drop needs a reason'
      printf 'dropped without a rule: %s\n' "$why"
      ;;
  esac
  /usr/bin/trash "$entry" >/dev/null 2>&1 || die "consumed, but could not trash $entry — remove it by hand"
  printf 'consumed %s\n' "${entry#"$ROOT/"}"
  ;;

''|-h|--help|help) usage ;;
*) usage; die "unknown command '$cmd'" ;;
esac
