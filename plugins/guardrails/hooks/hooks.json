{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/intercept.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/intercept.sh --reset" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tidy.sh" }
        ]
      }
    ]
  }
}
